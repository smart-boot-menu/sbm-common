{
  "$defs": {
    "CpuArch": {
      "enum": [
        "x86_64",
        "aarch64",
        "ia32",
        "riscv64"
      ],
      "type": "string"
    },
    "FirmwarePlatform": {
      "enum": [
        "uefi-native",
        "uefi-uboot",
        "apple-silicon-m1n1-uboot",
        "legacy-bios"
      ],
      "type": "string"
    },
    "PlatformCapabilities": {
      "properties": {
        "arch": {
          "$ref": "#/$defs/CpuArch"
        },
        "can_chainload_efi": {
          "type": "boolean"
        },
        "can_direct_chainload_macos": {
          "type": "boolean"
        },
        "external_usb_boot_supported": {
          "type": "boolean"
        },
        "firmware": {
          "$ref": "#/$defs/FirmwarePlatform"
        },
        "gop_framebuffer": {
          "type": "boolean"
        },
        "nvram_writable": {
          "type": "boolean"
        },
        "page_size_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ram_total_mib": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "secure_boot_state": {
          "$ref": "#/$defs/SecureBootState"
        },
        "tpm_present": {
          "type": "boolean"
        },
        "uefi_networking": {
          "type": "boolean"
        }
      },
      "required": [
        "arch",
        "firmware",
        "page_size_bytes",
        "secure_boot_state",
        "tpm_present",
        "nvram_writable",
        "gop_framebuffer",
        "uefi_networking",
        "can_chainload_efi",
        "can_direct_chainload_macos",
        "external_usb_boot_supported"
      ],
      "type": "object"
    },
    "SecureBootState": {
      "enum": [
        "disabled",
        "enabled",
        "setup_mode",
        "unsupported"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "device_public_key_ed25519_hex": {
      "type": "string"
    },
    "enrollment_token": {
      "type": "string"
    },
    "hostname": {
      "type": "string"
    },
    "platform": {
      "$ref": "#/$defs/PlatformCapabilities"
    },
    "schema_version": {
      "type": "string"
    },
    "tpm_attestation_b64": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "enrollment_token",
    "device_public_key_ed25519_hex",
    "hostname",
    "platform"
  ],
  "title": "EnrollmentRequest",
  "type": "object"
}
